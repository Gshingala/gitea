{{/* Value - value of the search field (for search results page) */}}
{{/* Disabled (optional) - if search field has to be disabled */}}
{{/* Placeholder (optional) - placeholder text to be used */}}
{{$placeholder := or .Placeholder (ctx.Locale.Tr "search.search")}}
<input type="search" name="q"{{with .Value}} value="{{.}}"{{end}} maxlength="255" spellcheck="false" placeholder="{{$placeholder}}" aria-label="{{$placeholder}}"{{if .Disabled}} disabled{{end}}>
